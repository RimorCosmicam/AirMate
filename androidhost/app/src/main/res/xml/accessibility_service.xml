<?xml version="1.0" encoding="utf-8"?>
<!--
    Two jobs, both of them windows rather than snooping.

    `canRetrieveWindowContent` is deliberately absent: nothing here reads what is on screen. The
    service exists to own an overlay window during pairing, and to dispatch taps and scrolls onto
    the desktop display, which is what `canPerformGestures` is for.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description" />
